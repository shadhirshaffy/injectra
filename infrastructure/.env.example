POSTGRES_PASSWORD=change-me
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_USER=injectra
DATABASE_NAME=injectra_db
REDIS_URL=redis://127.0.0.1:6379/0
MANAGEMENT_SOURCE_LIMIT_REQUESTS=300
MANAGEMENT_USER_LIMIT_REQUESTS=120
MANAGEMENT_WRITE_LIMIT_REQUESTS=30
MANAGEMENT_RATE_LIMIT_WINDOW_SECONDS=60
MANAGEMENT_RATE_LIMIT_PREFIX=injectra:management-rate:v1
GATEWAY_RATE_LIMIT_REQUESTS=60
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
GATEWAY_RATE_LIMIT_PREFIX=injectra:gateway-rate:v1

# Management endpoints remain disabled until an identity adapter is configured.
APP_ENVIRONMENT=production
DEV_ADMIN_ENABLED=false
MANAGEMENT_AUTH_PROVIDER=disabled
# MANAGEMENT_AUTH_PROVIDER=clerk
# CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# CLERK_SECRET_KEY=<server-only-secret-never-commit>
# CLERK_AUTHORIZED_PARTIES=["https://app.example.com"]
# CLERK_AUDIENCE=injectra-api
# Local development only: bind Uvicorn to 127.0.0.1, without proxy headers.
# APP_ENVIRONMENT=development
# DEV_ADMIN_ENABLED=true
# DEV_ADMIN_SUBJECT=local-admin
# DEV_ADMIN_TOKEN=<random-secret-at-least-32-characters>
# API_KEY_PEPPER=<different-random-secret-at-least-32-characters>
